# P3394 Runtime Agent deployment config

# Web
APP_PORT=8000
ADMIN_TOKEN=admin
WORKFLOW_API_KEY=sk-local-workflow-key
MCP_TOKEN=mcp-local-token
LOG_CONSOLE_LEVEL=WARNING

# Model config used by local-demo/models.example.json.
# Copy local-demo/models.example.json to local-demo/models.json before Docker Compose startup.
P3394_MODEL_NAME=gpt-4o-mini
P3394_MODEL_BASE_URL=
P3394_MODEL_API_KEY=

# PostgreSQL
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=agentclaw
PG_DATABASE=agentclaw

# Redis
REDIS_PORT=6379

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=agentclaw

# Milvus
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091

# Adminer database UI
ADMINER_PORT=8080
